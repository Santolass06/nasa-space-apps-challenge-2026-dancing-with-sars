# Copy to .env and fill in. Never commit .env.

# --- NASA Earthdata (required to download NISAR products) ------------------
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Backend ---------------------------------------------------------------
# Comma-separated list of allowed browser origins
SAR_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAR_API_HOST=0.0.0.0
SAR_API_PORT=8000
SAR_DATA_DIR=../data

# --- Frontend --------------------------------------------------------------
# Base URL of the API as seen by the browser
VITE_API_URL=http://localhost:8000
